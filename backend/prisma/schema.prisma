generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ExerciseLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

model Exercise {
  slug           String        @id
  name           String
  primaryMuscles String[]
  equipment      String
  level          ExerciseLevel
  category       String
  imageKey       String
}
