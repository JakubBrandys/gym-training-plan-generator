generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ExerciseLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

model Exercise {
  slug           String        @id
  name           String
  primaryMuscles String[]
  equipment      String
  level          ExerciseLevel
  category       String
  imageKey       String
}

enum ProfileRole {
  MEMBER
  ADMIN
}

model Profile {
  id         String      @id @db.Uuid
  email      String
  role       ProfileRole @default(MEMBER)
  blockedAt  DateTime?
  createdAt  DateTime    @default(now())
  savedPlans SavedPlan[]
}

model SavedPlan {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  owner       Profile  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceJobId String   @db.Uuid
  form        Json
  plan        Json
  createdAt   DateTime @default(now())

  @@unique([ownerId, sourceJobId])
  @@index([ownerId, createdAt])
}
